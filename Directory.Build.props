<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Code analysis on every build: the .NET analyzers at their recommended set, plus the code-style
       rules .editorconfig marks as warnings. Locally they stay warnings; in CI (GitHub Actions sets
       CI=true) every warning is an error, so nothing is merged with one. -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>

    <!-- The compiler reports unnecessary usings (IDE0005) only when it builds the XML documentation,
         which also checks every doc comment that is written. Comments are written where they explain
         something, not on every member or parameter, so neither a missing doc comment (CS1591) nor
         a parameter left out of one (CS1573) is a warning. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <!-- The default (neutral) resources are English; satellite assemblies hold the other cultures. -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
</Project>