<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Hangfire.AspNetCore" />
		<PackageReference Include="Hangfire.PostgreSql" />
		<PackageReference Include="Serilog.AspNetCore" />
		<PackageReference Include="Serilog.Sinks.Seq" />
		<PackageReference Include="MailKit" />
		<PackageReference Include="Twilio" />
		<!-- Lifts the vulnerable version MailKit brings in transitively; see Directory.Packages.props. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" />
	</ItemGroup>
	
  <ItemGroup>
	<ProjectReference Include="..\BookingHub.Application\BookingHub.Application.csproj" />
	<ProjectReference Include="..\BookingHub.Domain\BookingHub.Domain.csproj" />
  </ItemGroup>

	<ItemGroup>
		<!-- Applied by the InitialCreate migration through Persistence/DatabaseObjects.cs. -->
		<EmbeddedResource Include="Persistence\Sql\*.sql" LogicalName="Sql/%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="BookingHub.Infrastructure.IntegrationTests" />
	</ItemGroup>

</Project>