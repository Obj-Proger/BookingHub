<EditForm Model="_input" OnValidSubmit="SaveAsync">
    <div class="form-field">
        <label>@Label</label>
        <InputText type="@InputType" @bind-Value="_input.Value" disabled="@ReadOnly" />
    </div>
    @if (_validationMessage is not null)
    {
        <p class="error-text">@_validationMessage</p>
    }
    @if (!ReadOnly)
    {
        <SaveStatus Saved="_saved" Error="_error" />
        <button type="submit" disabled="@_isSaving">@(_isSaving ? "Saving…" : "Save")</button>
    }
</EditForm>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter, EditorRequired] public Func<string, Task<ApiResult>> Save { get; set; } = default!;
    [Parameter] public EventCallback<string> OnSaved { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string InputType { get; set; } = "text";

    /// <summary>When false, an empty value is allowed and passed to <see cref="Save"/> as an empty string.</summary>
    [Parameter] public bool Required { get; set; } = true;

    private readonly TextInput _input = new();
    private string? _validationMessage;
    private ApiError? _error;
    private bool _saved;
    private bool _isSaving;

    protected override void OnInitialized() => _input.Value = Value;

    private async Task SaveAsync()
    {
        _saved = false;
        _error = null;
        _validationMessage = null;

        var trimmed = _input.Value.Trim();
        if (Required && trimmed.Length == 0)
        {
            _validationMessage = "A value is required.";
            return;
        }

        _isSaving = true;
        try
        {
            var result = await Save(trimmed);
            if (!result.IsSuccess)
            {
                _error = result.Error;
                return;
            }

            _input.Value = trimmed;
            _saved = true;
            await OnSaved.InvokeAsync(trimmed);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private sealed class TextInput
    {
        public string Value { get; set; } = string.Empty;
    }
}