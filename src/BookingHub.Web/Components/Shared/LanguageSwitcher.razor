@using System.Globalization
@implements IDisposable
@inject NavigationManager Navigation

<form method="get" action="/culture/set" class="language-switcher" title="@L["Language_Switch"]">
    <input type="hidden" name="returnUrl" value="@ReturnUrl" />
    @foreach (var culture in SupportedCultures.All)
    {
        <button type="submit" name="culture" value="@culture" class="@ButtonClass(culture)">@culture.ToUpperInvariant()</button>
    }
</form>

@code {
    private string ReturnUrl => "/" + Navigation.ToBaseRelativePath(Navigation.Uri);

    // The switcher lives in a layout, which is not re-rendered when an interactive page navigates,
    // so without this the hidden returnUrl would keep pointing at the first page of the circuit.
    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private static string ButtonClass(string culture) =>
        CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == culture ? "link-button language-current" : "link-button";
}