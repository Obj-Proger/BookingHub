@inject NavigationManager Navigation

<div class="state-panel state-error" role="alert">
    @if (Error.IsUnauthorized)
    {
        <p>Your session has expired.</p>
        <a href="@SignInUrl">Sign in again</a>
    }
    else
    {
        <p>@Error.Message</p>
        @if (OnRetry.HasDelegate)
        {
            <button type="button" @onclick="OnRetry">Try again</button>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public ApiError Error { get; set; } = default!;
    [Parameter] public EventCallback OnRetry { get; set; }

    private string SignInUrl =>
        "/login?returnUrl=" + Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri));
}