@page "/book/{OrganizationSlug}"
@inject IPublicCatalogApiClient CatalogApiClient

<PageTitle>Book an appointment</PageTitle>

<h1>Choose a location</h1>

@if (_error is not null)
{
    <ErrorState Error="_error" OnRetry="LoadAsync" />
}
else if (_locations is null)
{
    <LoadingState />
}
else if (_locations.Count == 0)
{
    <p>No locations are available for booking right now.</p>
}
else
{
    <div class="card-list">
        @foreach (var location in _locations)
        {
            <a class="card" href="@($"/book/{OrganizationSlug}/{location.LocationId}")">
                <h2>@location.Name</h2>
                <p>@location.Address</p>
            </a>
        }
    </div>
}

@code {
    [Parameter] public string OrganizationSlug { get; set; } = string.Empty;

    private IReadOnlyList<PublicLocationResponse>? _locations;
    private ApiError? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        _locations = null;

        var result = await CatalogApiClient.GetLocationsAsync(OrganizationSlug, CancellationToken.None);
        if (result.IsSuccess)
            _locations = result.Value;
        else
            _error = result.Error;
    }
}