@page "/book/{OrganizationSlug}/{LocationId:guid}/{ServiceId:guid}/{EmployeeId:guid}"
@inject IPublicCatalogApiClient CatalogApiClient
@inject IPublicBookingsApiClient BookingsApiClient
@inject IPublicWaitlistApiClient WaitlistApiClient
@inject TimeProvider Clock

<PageTitle>Pick a time</PageTitle>

@if (_locationNotFound)
{
    <p>This location isn't available for booking.</p>
    <a class="back-link" href="@($"/book/{OrganizationSlug}")">&larr; Back to locations</a>
}
else if (_locationTime is null)
{
    <p>Loading…</p>
}
else if (_confirmedBooking is not null)
{
    <h1>Almost there</h1>
    <p>Requested: @_locationTime.ToLocal(_confirmedBooking.StartUtc).ToString("f")</p>
    <p>We've sent a confirmation link to your phone/email — open it to confirm this booking. Until then the time is not reserved for you.</p>
}
else
{
    <h1>Pick a time</h1>

    <input type="date" @bind="_selectedDate" @bind:after="LoadSlotsAsync"
           min="@_locationTime.Today(Clock).ToString("yyyy-MM-dd")" />
    <p>Times are shown in the location's time zone (@_locationTime.ZoneId).</p>

    @if (_slots is null)
    {
        <p>Loading…</p>
    }
    else if (_slots.Count == 0)
    {
        <p>No open times on this day.</p>

        @if (_waitlistJoined)
        {
            <p>You're on the waitlist — we'll text/email you if a spot opens up.</p>
        }
        else
        {
            <button type="button" @onclick="() => _showWaitlistForm = true">Join the waitlist for this day instead</button>

            @if (_showWaitlistForm)
            {
                <EditForm Model="_guestDetails" OnValidSubmit="JoinWaitlistAsync" FormName="waitlist-details">
                    <DataAnnotationsValidator />
                    <div class="form-field">
                        <label>Phone</label>
                        <InputText @bind-Value="_guestDetails.Phone" placeholder="+1 555 123 4567" />
                    </div>
                    <div class="form-field">
                        <label>Name (optional)</label>
                        <InputText @bind-Value="_guestDetails.Name" />
                    </div>
                    <ValidationSummary />
                    @if (_errorMessage is not null)
                    {
                        <p class="error-text">@_errorMessage</p>
                    }
                    <button type="submit" disabled="@_isSubmitting">@(_isSubmitting ? "Joining…" : "Join waitlist")</button>
                </EditForm>
            }
        }
    }
    else
    {
        <div class="slot-grid">
            @foreach (var slot in _slots)
            {
                <button type="button" class="@(slot == _selectedSlot ? "slot slot-selected" : "slot")"
                        @onclick="() => _selectedSlot = slot">
                    @_locationTime.ToLocal(slot.StartUtc).ToString("HH:mm")
                </button>
            }
        </div>
    }

    @if (_selectedSlot is not null)
    {
        <EditForm Model="_guestDetails" OnValidSubmit="SubmitAsync" FormName="guest-details">
            <DataAnnotationsValidator />
            <div class="form-field">
                <label>Phone</label>
                <InputText @bind-Value="_guestDetails.Phone" placeholder="+1 555 123 4567" />
            </div>
            <div class="form-field">
                <label>Name (optional)</label>
                <InputText @bind-Value="_guestDetails.Name" />
            </div>
            <div class="form-field">
                <label>Email (optional)</label>
                <InputText @bind-Value="_guestDetails.Email" />
            </div>
            <ValidationSummary />
            @if (_errorMessage is not null)
            {
                <p class="error-text">@_errorMessage</p>
            }
            <button type="submit" disabled="@_isSubmitting">@(_isSubmitting ? "Booking…" : "Confirm booking")</button>
        </EditForm>
    }

    <a class="back-link" href="@($"/book/{OrganizationSlug}/{LocationId}/{ServiceId}")">&larr; Back to specialists</a>
}

@code {
    [Parameter] public string OrganizationSlug { get; set; } = string.Empty;
    [Parameter] public Guid LocationId { get; set; }
    [Parameter] public Guid ServiceId { get; set; }
    [Parameter] public Guid EmployeeId { get; set; }

    private LocationTime? _locationTime;
    private bool _locationNotFound;
    private DateOnly _selectedDate;
    private IReadOnlyList<AvailableSlotResponse>? _slots;
    private AvailableSlotResponse? _selectedSlot;
    private readonly GuestDetails _guestDetails = new();
    private string? _errorMessage;
    private bool _isSubmitting;
    private BookingCreatedResponse? _confirmedBooking;
    private bool _showWaitlistForm;
    private bool _waitlistJoined;

    protected override async Task OnInitializedAsync()
    {
        var location = await CatalogApiClient.GetLocationAsync(OrganizationSlug, LocationId, CancellationToken.None);
        if (location is null)
        {
            _locationNotFound = true;
            return;
        }

        _locationTime = LocationTime.FromZoneId(location.TimeZone);
        _selectedDate = _locationTime.Today(Clock);
        await LoadSlotsAsync();
    }

    private async Task LoadSlotsAsync()
    {
        _selectedSlot = null;
        _showWaitlistForm = false;
        _waitlistJoined = false;
        _slots = await BookingsApiClient.GetAvailableSlotsAsync(OrganizationSlug, LocationId, EmployeeId, ServiceId, _selectedDate, CancellationToken.None) ?? [];
    }

    private async Task SubmitAsync()
    {
        if (_selectedSlot is null)
            return;

        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            var booking = await BookingsApiClient.CreateBookingAsync(
                OrganizationSlug,
                new CreateBookingRequest(LocationId, EmployeeId, ServiceId, _selectedSlot.StartUtc, _guestDetails.Phone, _guestDetails.Name, _guestDetails.Email),
                CancellationToken.None);

            if (booking is null)
            {
                _errorMessage = "This time just became unavailable — please pick another slot.";
                await LoadSlotsAsync();
                return;
            }

            _confirmedBooking = booking;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private async Task JoinWaitlistAsync()
    {
        if (_locationTime is null)
            return;

        _isSubmitting = true;
        _errorMessage = null;
        try
        {
            var (windowStartUtc, windowEndUtc) = _locationTime.GetRemainingDayWindowUtc(_selectedDate, Clock);

            var entry = await WaitlistApiClient.JoinAsync(
                OrganizationSlug,
                new JoinWaitlistRequest(LocationId, EmployeeId, ServiceId, windowStartUtc, windowEndUtc, _guestDetails.Phone, _guestDetails.Name, null),
                CancellationToken.None);

            if (entry is null)
            {
                _errorMessage = "Couldn't join the waitlist — check your phone number and try again.";
                return;
            }

            _waitlistJoined = true;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class GuestDetails
    {
        [Required(ErrorMessage = "Phone number is required.")]
        public string Phone { get; set; } = string.Empty;

        public string? Name { get; set; }

        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string? Email { get; set; }
    }
}