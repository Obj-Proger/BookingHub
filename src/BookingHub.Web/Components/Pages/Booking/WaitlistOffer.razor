@page "/book/{OrganizationSlug}/waitlist/{WaitlistEntryId:guid}"
@inject IPublicWaitlistApiClient WaitlistApiClient

<PageTitle>A spot opened up</PageTitle>

@if (_outcome is not null)
{
    <h1>@_outcome</h1>
}
else
{
    <h1>A spot opened up</h1>
    <p>Would you like to take this slot, or stay on the waitlist for something else?</p>

    <button type="button" @onclick="ConfirmAsync" disabled="@_isBusy">Take this slot</button>
    <button type="button" @onclick="LeaveAsync" disabled="@_isBusy">Leave the waitlist</button>

    @if (_error is not null)
    {
        <ErrorState Error="_error" />
    }
}

@code {
    [Parameter] public string OrganizationSlug { get; set; } = string.Empty;
    [Parameter] public Guid WaitlistEntryId { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private bool _isBusy;
    private string? _outcome;
    private ApiError? _error;

    private Task ConfirmAsync() => RunAsync(
        () => WaitlistApiClient.ConfirmOfferAsync(OrganizationSlug, WaitlistEntryId, Token, CancellationToken.None),
        "Booked! See you then.");

    private Task LeaveAsync() => RunAsync(
        () => WaitlistApiClient.LeaveAsync(OrganizationSlug, WaitlistEntryId, Token, CancellationToken.None),
        "You've been removed from the waitlist.");

    private async Task RunAsync(Func<Task<ApiResult>> action, string successOutcome)
    {
        _isBusy = true;
        _error = null;
        try
        {
            var result = await action();
            if (result.IsSuccess)
                _outcome = successOutcome;
            else
                _error = result.Error;
        }
        finally
        {
            _isBusy = false;
        }
    }
}