@page "/book/{OrganizationSlug}/manage/{BookingId:guid}"
@using System.Net
@inject IPublicBookingsApiClient BookingsApiClient
@inject IPublicCatalogApiClient CatalogApiClient
@inject TimeProvider Clock

<PageTitle>Manage your booking</PageTitle>

@if (_loadError is not null)
{
    <ErrorState Error="_loadError" OnRetry="LoadAsync" />
}
else if (_booking is null || _locationTime is null)
{
    <LoadingState />
}
else if (_cancelled)
{
    <h1>Booking cancelled</h1>
}
else if (_rescheduled is not null)
{
    <h1>Booking rescheduled</h1>
    <p>New time: @_locationTime.ToLocal(_rescheduled.StartUtc).ToString("f")</p>
}
else
{
    <h1>@_booking.ServiceName</h1>
    <p>@_locationTime.ToLocal(_booking.StartUtc).ToString("f") — status: @_booking.Status</p>

    @if (_booking.Status is BookingStatus.Pending or BookingStatus.Confirmed)
    {
        <h2>Cancel</h2>
        <input placeholder="Reason (optional)" @bind="_cancelReason" />
        <button type="button" @onclick="CancelAsync" disabled="@_isBusy">Cancel booking</button>

        <h2>Reschedule</h2>
        <input type="date" @bind="_selectedDate" @bind:after="LoadSlotsAsync"
               min="@_locationTime.Today(Clock).ToString("yyyy-MM-dd")" />
        <p>Times are shown in the location's time zone (@_locationTime.ZoneId).</p>

        @if (_slotsError is not null)
        {
            <ErrorState Error="_slotsError" OnRetry="LoadSlotsAsync" />
        }
        else if (_slots is null)
        {
            <LoadingState />
        }
        else if (_slots.Count == 0)
        {
            <p>No open times on this day.</p>
        }
        else
        {
            <div class="slot-grid">
                @foreach (var slot in _slots)
                {
                    <button type="button" class="@(slot == _selectedSlot ? "slot slot-selected" : "slot")"
                            @onclick="() => _selectedSlot = slot">
                        @_locationTime.ToLocal(slot.StartUtc).ToString("HH:mm")
                    </button>
                }
            </div>
        }

        @if (_selectedSlot is not null)
        {
            <button type="button" @onclick="RescheduleAsync" disabled="@_isBusy">Confirm new time</button>
        }
    }

    @if (_actionError is not null)
    {
        <ErrorState Error="_actionError" />
    }
}

@code {
    [Parameter] public string OrganizationSlug { get; set; } = string.Empty;
    [Parameter] public Guid BookingId { get; set; }
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private PublicBookingDetailsResponse? _booking;
    private LocationTime? _locationTime;
    private ApiError? _loadError;
    private bool _isBusy;
    private bool _cancelled;
    private BookingCreatedResponse? _rescheduled;
    private string? _cancelReason;
    private DateOnly _selectedDate;
    private IReadOnlyList<AvailableSlotResponse>? _slots;
    private ApiError? _slotsError;
    private AvailableSlotResponse? _selectedSlot;
    private ApiError? _actionError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loadError = null;

        var booking = await BookingsApiClient.GetBookingAsync(OrganizationSlug, BookingId, Token, CancellationToken.None);
        if (!booking.IsSuccess)
        {
            _loadError = booking.Error;
            return;
        }

        var location = await CatalogApiClient.GetLocationAsync(OrganizationSlug, booking.Value.LocationId, CancellationToken.None);
        if (!location.IsSuccess)
        {
            _loadError = location.Error;
            return;
        }

        _locationTime = LocationTime.FromZoneId(location.Value.TimeZone);
        _selectedDate = _locationTime.Today(Clock);
        _booking = booking.Value;

        if (_booking.Status is BookingStatus.Pending or BookingStatus.Confirmed)
            await LoadSlotsAsync();
    }

    private async Task LoadSlotsAsync()
    {
        if (_booking is null)
            return;

        _selectedSlot = null;
        _slots = null;
        _slotsError = null;

        var result = await BookingsApiClient.GetAvailableSlotsAsync(
            OrganizationSlug, _booking.LocationId, _booking.EmployeeId, _booking.ServiceId, _selectedDate, CancellationToken.None);
        if (result.IsSuccess)
            _slots = result.Value;
        else
            _slotsError = result.Error;
    }

    private async Task CancelAsync()
    {
        _isBusy = true;
        _actionError = null;
        try
        {
            var result = await BookingsApiClient.CancelBookingAsync(OrganizationSlug, BookingId, Token, _cancelReason, CancellationToken.None);
            if (result.IsSuccess)
                _cancelled = true;
            else
                _actionError = result.Error;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RescheduleAsync()
    {
        if (_selectedSlot is null)
            return;

        _isBusy = true;
        _actionError = null;
        try
        {
            var result = await BookingsApiClient.RescheduleBookingAsync(
                OrganizationSlug, BookingId, Token, _selectedSlot.StartUtc, CancellationToken.None);

            if (result.IsSuccess)
            {
                _rescheduled = result.Value;
                return;
            }

            _actionError = result.Error;

            // The time was taken meanwhile: show what is still free.
            if (result.Error!.StatusCode == HttpStatusCode.Conflict)
                await LoadSlotsAsync();
        }
        finally
        {
            _isBusy = false;
        }
    }
}