@page "/app"
@attribute [Authorize]
@layout StaffLayout
@inject MembershipCache Memberships
@inject NavigationManager Navigation

<PageTitle>@L["Orgs_Title"]</PageTitle>

<h1>@L["Orgs_Title"]</h1>

@if (_error is not null)
{
    <ErrorState Error="_error" OnRetry="LoadAsync" />
}
else if (_memberships is null)
{
    <LoadingState />
}
else
{
    <div class="card-list">
        @foreach (var membership in _memberships)
        {
            <a class="card" href="@StaffRoutes.Organization(membership.OrganizationId)">
                <h2>@membership.OrganizationName</h2>
                <p>@L[$"Role_{membership.Role}"]</p>
            </a>
        }
    </div>
    <a class="back-link" href="@StaffRoutes.NewOrganization">@L["Orgs_Create"]</a>
}

@code {
    private IReadOnlyList<MyOrganizationMembershipResponse>? _memberships;
    private ApiError? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;

        var result = await Memberships.GetAsync(CancellationToken.None);
        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        switch (result.Value)
        {
            case []:
                Navigation.NavigateTo(StaffRoutes.NewOrganization, replace: true);
                break;
            case [var only]:
                Navigation.NavigateTo(StaffRoutes.Organization(only.OrganizationId), replace: true);
                break;
            default:
                _memberships = result.Value;
                break;
        }
    }
}