@page "/app/new"
@attribute [Authorize]
@layout StaffLayout
@inject IOrganizationsApiClient OrganizationsApiClient
@inject MembershipCache Memberships
@inject NavigationManager Navigation

<PageTitle>@L["NewOrg_PageTitle"]</PageTitle>

<h1>@L["NewOrg_Title"]</h1>

<EditForm Model="_input" OnValidSubmit="SubmitAsync" FormName="create-organization">
    <DataAnnotationsValidator />
    <div class="form-field">
        <label>@L["NewOrg_Name"]</label>
        <InputText @bind-Value="_input.Name" @bind-Value:after="SuggestSlug" />
    </div>
    <div class="form-field">
        <label>@L["NewOrg_Address"]</label>
        <InputText @bind-Value="_input.Slug" @bind-Value:after="MarkSlugEdited" />
    </div>
    <p class="hint">
        @L["NewOrg_HintBookAt"] <code>/book/@(string.IsNullOrWhiteSpace(_input.Slug) ? L["NewOrg_DefaultAddress"].Value : _input.Slug)</code>.
        @L["NewOrg_HintFormat"]
    </p>
    <ValidationSummary />
    @if (_error is not null)
    {
        <ErrorState Error="_error" />
    }
    <button type="submit" disabled="@_isSubmitting">@(_isSubmitting ? L["NewOrg_Creating"] : L["NewOrg_Submit"])</button>
</EditForm>

<a class="back-link" href="@StaffRoutes.Home">&larr; @L["Common_Back"]</a>

@code {
    private readonly OrganizationInput _input = new();
    private ApiError? _error;
    private bool _isSubmitting;
    private bool _slugEdited;

    private void SuggestSlug()
    {
        if (!_slugEdited)
            _input.Slug = SlugSuggestion.FromName(_input.Name);
    }

    private void MarkSlugEdited() => _slugEdited = true;

    private async Task SubmitAsync()
    {
        _isSubmitting = true;
        _error = null;
        try
        {
            var result = await OrganizationsApiClient.CreateAsync(_input.Name.Trim(), _input.Slug.Trim(), CancellationToken.None);
            if (!result.IsSuccess)
            {
                _error = result.Error;
                return;
            }

            Memberships.Invalidate();
            Navigation.NavigateTo(StaffRoutes.Organization(result.Value.OrganizationId));
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private sealed class OrganizationInput
    {
        [LocalizedRequired("Validation_NameRequired")]
        public string Name { get; set; } = string.Empty;

        [LocalizedRequired("Validation_AddressRequired")]
        public string Slug { get; set; } = string.Empty;
    }
}