@page "/login"
@attribute [ExcludeFromInteractiveRouting]
@inject IAuthApiClient AuthApiClient
@inject StaffSessionManager SessionManager
@inject NavigationManager Navigation

<PageTitle>@L["Login_Title"]</PageTitle>

<h1>@L["Login_Title"]</h1>

<EditForm Model="Input" FormName="login" OnValidSubmit="SignInAsync" method="post">
    <DataAnnotationsValidator />
    <div class="form-field">
        <label>@L["Login_Email"]</label>
        <InputText type="email" @bind-Value="Input!.Email" autocomplete="username" />
    </div>
    <div class="form-field">
        <label>@L["Login_Password"]</label>
        <InputText type="password" @bind-Value="Input!.Password" autocomplete="current-password" />
    </div>
    <ValidationSummary />
    @if (_errorMessage is not null)
    {
        <p class="error-text">@_errorMessage</p>
    }
    <button type="submit">@L["Login_Submit"]</button>
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromForm] private LoginInput? Input { get; set; }

    private string? _errorMessage;

    protected override void OnInitialized() => Input ??= new();

    private async Task SignInAsync()
    {
        var email = Input!.Email.Trim();
        var result = await AuthApiClient.LoginAsync(email, Input.Password, CancellationToken.None);

        if (result.Outcome != LoginOutcome.Success)
        {
            _errorMessage = result.Outcome switch
            {
                LoginOutcome.InvalidCredentials => L["Login_Error_Invalid"],
                LoginOutcome.TooManyRequests => L["Login_Error_TooMany"],
                _ => L["Error_Status_ServiceUnavailable"]
            };
            return;
        }

        if (!await SessionManager.SignInAsync(HttpContext, email, result.Tokens!, CancellationToken.None))
        {
            _errorMessage = L["Login_Error_Failed"];
            return;
        }

        Navigation.NavigateTo(LocalUrl.OrDefault(ReturnUrl, "/app"), forceLoad: true);
    }

    private sealed class LoginInput
    {
        [LocalizedRequired("Validation_EmailRequired")]
        [LocalizedEmailAddress("Validation_EmailInvalid")]
        public string Email { get; set; } = string.Empty;

        [LocalizedRequired("Validation_PasswordRequired")]
        public string Password { get; set; } = string.Empty;
    }
}