@inject IOrganizationsApiClient OrganizationsApiClient
@inject MembershipCache Memberships

<section class="settings-section">
    <h2>General</h2>
    <TextSettingRow Label="Name"
                    Value="@Organization.Name"
                    Save="@(newName => OrganizationsApiClient.RenameAsync(Organization.OrganizationId, newName, CancellationToken.None))"
                    OnSaved="OnRenamed" />
    <p class="hint">Booking address: <code>/book/@Organization.Slug</code></p>
</section>

@code {
    [Parameter, EditorRequired] public OrganizationResponse Organization { get; set; } = default!;

    private void OnRenamed(string newName) => Memberships.RenameOrganization(Organization.OrganizationId, newName);
}