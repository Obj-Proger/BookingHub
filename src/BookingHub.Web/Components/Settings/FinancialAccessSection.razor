@inject IOrganizationsApiClient OrganizationsApiClient

<section class="settings-section">
    <h2>Financial access</h2>
    <ToggleSettingRow Label="Administrators can view financial data (such as revenue)"
                      Description="Owners always have access. Only owners can change this setting."
                      Value="Organization.CanAdministratorsViewFinancials"
                      Save="@(enabled => OrganizationsApiClient.SetAdministratorFinancialAccessAsync(
                          Organization.OrganizationId, enabled, CancellationToken.None))" />
</section>

@code {
    [Parameter, EditorRequired] public OrganizationResponse Organization { get; set; } = default!;
}