@inherits LayoutComponentBase
@using Microsoft.JSInterop
@layout StaffLayout
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject MembershipCache Memberships
@inject IJSRuntime JS

@if (_error is not null)
{
    <ErrorState Error="_error" OnRetry="LoadAsync" />
}
else if (_memberships is null)
{
    <LoadingState />
}
else if (_membership is null)
{
    <EmptyState Title="@L["Org_NotFound_Title"]"
                Description="@L["Org_NotFound_Description"]">
        <a class="back-link" href="@StaffRoutes.Home">@L["Common_BackToOrganizations"]</a>
    </EmptyState>
}
else
{
    <div class="org-shell">
        <nav class="org-nav">
            <div class="org-nav-title">
                <strong>@_membership.OrganizationName</strong>
                <span>@L[$"Role_{_membership.Role}"]</span>
            </div>
            <div class="org-nav-links">
                @foreach (var item in StaffNavigation.ItemsFor(_membership.Role))
                {
                    <NavLink href="@StaffNavigation.Href(_membership.OrganizationId, item)"
                             Match="@(item.Segment.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        @L[item.TitleKey]
                    </NavLink>
                }
            </div>
            <div class="org-nav-secondary">
                @if (_memberships.Count > 1)
                {
                    <a href="@StaffRoutes.Home">@L["Nav_SwitchOrganization"]</a>
                }
                <a href="@StaffRoutes.NewOrganization">@L["Nav_NewOrganization"]</a>
            </div>
        </nav>
        <section class="org-content">
            <CascadingValue Value="_membership">
                @Body
            </CascadingValue>
        </section>
    </div>
}

@code {
    private IReadOnlyList<MyOrganizationMembershipResponse>? _memberships;
    private MyOrganizationMembershipResponse? _membership;
    private ApiError? _error;
    private IJSObjectReference? _navigationScript;

    /// <summary>Set when the page changes, so the link to it is brought into view once rendered.</summary>
    private bool _revealActiveLink = true;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Memberships.Changed += OnMembershipsChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;

        var result = await Memberships.GetAsync(CancellationToken.None);
        if (!result.IsSuccess)
        {
            _error = result.Error;
            return;
        }

        _memberships = result.Value;
        ResolveMembership();
    }

    private void ResolveMembership() =>
        _membership = _memberships is not null && StaffRoutes.TryGetOrganizationId(Navigation.Uri, out var organizationId)
            ? _memberships.FirstOrDefault(membership => membership.OrganizationId == organizationId)
            : null;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ResolveMembership();
        _revealActiveLink = true;
        InvokeAsync(StateHasChanged);
    }

    // On a narrow screen the navigation is one row that scrolls sideways, where the current page's link
    // can be out of sight (Settings, at the end); this scrolls it into view. A no-op when it is visible.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_revealActiveLink || _membership is null)
            return;

        _revealActiveLink = false;
        _navigationScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/navigation.js");
        await _navigationScript.InvokeVoidAsync("revealActiveLink", ".org-nav-links");
    }

    private void OnMembershipsChanged() =>
        InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        Memberships.Changed -= OnMembershipsChanged;

        if (_navigationScript is not null)
        {
            try
            {
                await _navigationScript.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone, and the browser side with it.
            }
        }
    }
}