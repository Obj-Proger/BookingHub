<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:BookingHub.Mobile.ViewModels"
             xmlns:localization="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
             x:Class="BookingHub.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False">

    <Grid Padding="24" RowDefinitions="*,Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="16" VerticalOptions="Center"
                             IsVisible="{Binding IsCredentialsStepVisible}">
            <Label Text="{localization:Translate Login_Title}" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" />
            <Entry Placeholder="{localization:Translate Login_EmailPlaceholder}" Text="{Binding Email}" Keyboard="Email" />
            <Entry Placeholder="{localization:Translate Login_PasswordPlaceholder}" Text="{Binding Password}" IsPassword="True" />
            <Button Text="{localization:Translate Login_SignInButton}" Command="{Binding LoginCommand}" />
            <Button Text="RU / EN" Command="{Binding ToggleLanguageCommand}" HorizontalOptions="Center" BackgroundColor="Transparent" TextColor="Gray" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="0" Spacing="12" IsVisible="{Binding IsOrganizationStepVisible}">
            <Label Text="{localization:Translate Login_SelectOrganizationTitle}" FontSize="20" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Organizations}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16" Margin="0,4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LoginViewModel}}, Path=SelectOrganizationCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding OrganizationName}" FontSize="16" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="0" Spacing="12" IsVisible="{Binding IsLocationStepVisible}">
            <Label Text="{localization:Translate Login_SelectLocationTitle}" FontSize="20" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Locations}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16" Margin="0,4">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LoginViewModel}}, Path=SelectLocationCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding LocationName}" FontSize="16" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>